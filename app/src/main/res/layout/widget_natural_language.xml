<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_nl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- AI Sparkle Icon Badge -->
    <ImageView
        android:id="@+id/widget_nl_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_widget_ai_badge"
        android:contentDescription="@string/widget_nl_name"
        android:padding="8dp"
        android:src="@drawable/ic_widget_sparkle" />

    <!-- Center Texts -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_nl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nl_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_nl_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nl_prompt"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Right Mic / Action Button -->
    <ImageView
        android:id="@+id/widget_nl_btn_mic"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_widget_ai_button"
        android:contentDescription="@string/widget_nl_name"
        android:padding="9dp"
        android:src="@drawable/ic_widget_mic" />

</LinearLayout>
